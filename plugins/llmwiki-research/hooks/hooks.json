{
  "description": "Optionally record successful file-changing tool calls as untrusted H-04 host-event hints.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|write_file|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/runtime/python/python.exe\" -I -B \"${PLUGIN_ROOT}/scripts/host_event.py\"",
            "async": true
          }
        ]
      }
    ]
  }
}
